39016>>>        WebSet pbRender of oEditBtn to False
39017>>>        WebSet pbRender of oSaveBtn to False
39018>>>        WebSet pbRender of oCancelChangesBtn to False
39019>>>        WebSet pbRender of oDeleteBtn to False
39020>>>
39020>>>        If (NavigateData.bReadOnly) Begin
