37630>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37633>>>        Case Begin
37633>>>            Case (NavigateData.eNavigateType = nfFromMain)
37635>>>                // If from main, this is a propbably a main file Select to Zoom.
37635>>>                Case Break
37636>>>
37636>>>            Case (NavigateData.eNavigateType = nfFromParent)
37639>>>                // If from parent, this is a constrained drill down.
37639>>>                Case Break
37640>>>
37640>>>            Case (NavigateData.eNavigateType = nfFromChild)
37643>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37643>>>                Case Break
37644>>>
37644>>>            Case Else // must be nfUndefined
37644>>>
37644>>>        Case End
37644>>>
37644>>>        Send SetActionButtons
37645>>>
37645>>>    End_Procedure
37646>>>
37646>>>End_Object 
