38970>>>        Get HasRecord of hoDD to bHasRecord
38971>>>
38971>>>        // let's hide all buttons and then Show the ones we want
38971>>>        WebSet pbRender of oEditBtn to False
38972>>>        WebSet pbRender of oSaveBtn to False
38973>>>        WebSet pbRender of oCancelChangesBtn to False
38974>>>        WebSet pbRender of oDeleteBtn to False
38975>>>
38975>>>        If (NavigateData.bReadOnly) Begin
38977>>>            WebSet pbRender of oEditBtn to True
38978>>>        End
38978>>>>
38978>>>        Else Begin
38979>>>            WebSet pbRender of oSaveBtn to True
38980>>>            WebSet pbRender of oCancelChangesBtn to True
38981>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38982>>>        End
38982>>>>
