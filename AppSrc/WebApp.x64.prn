37783>>>>>            Case (NavigateData.eNavigateType = nfFromChild)
37786>>>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37786>>>>>                Case Break
37787>>>>>
37787>>>>>            Case Else // must be nfUndefined
37787>>>>>
37787>>>>>        Case End
37787>>>>>
37787>>>>>        Send SetActionButtons
