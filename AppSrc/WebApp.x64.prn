38360>>>        Case Begin
38360>>>            Case (NavigateData.eNavigateType = nfFromMain)
38362>>>                // If from main, this is a propbably a main file Select to Zoom.
38362>>>                Case Break
38363>>>
38363>>>            Case (NavigateData.eNavigateType = nfFromParent)
38366>>>                // If from parent, this is a constrained drill down.
38366>>>                Case Break
38367>>>
38367>>>            Case (NavigateData.eNavigateType = nfFromChild)
38370>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38370>>>                Case Break
38371>>>
38371>>>            Case Else // must be nfUndefined
38371>>>
38371>>>        Case End
38371>>>
38371>>>        Send SetActionButtons
38372>>>
38372>>>    End_Procedure
38373>>>
38373>>>End_Object 
