37606>>>    Procedure SetActionButtons
37609>>>        tWebNavigateData NavigateData
37609>>>        tWebNavigateData NavigateData
37609>>>        Boolean bHasRecord
37609>>>        Handle hoDD
37609>>>
37609>>>        Get Server to hoDD
37610>>>        Get GetNavigateData to NavigateData
37611>>>        Get HasRecord of hoDD to bHasRecord
37612>>>
37612>>>        // let's hide all buttons and then Show the ones we want
37612>>>        WebSet pbRender of oEditBtn to False
37613>>>        WebSet pbRender of oSaveBtn to False
37614>>>        WebSet pbRender of oCancelChangesBtn to False
37615>>>        WebSet pbRender of oDeleteBtn to False
37616>>>
37616>>>        If (NavigateData.bReadOnly) Begin
37618>>>            WebSet pbRender of oEditBtn to True
37619>>>        End
37619>>>>
37619>>>        Else Begin
37620>>>            WebSet pbRender of oSaveBtn to True
37621>>>            WebSet pbRender of oCancelChangesBtn to True
37622>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37623>>>        End
37623>>>>
37623>>>    End_Procedure
