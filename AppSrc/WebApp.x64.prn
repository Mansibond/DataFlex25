38329>>>    Procedure SetActionButtons
38332>>>        tWebNavigateData NavigateData
38332>>>        tWebNavigateData NavigateData
38332>>>        Boolean bHasRecord
38332>>>        Handle hoDD
38332>>>
38332>>>        Get Server to hoDD
38333>>>        Get GetNavigateData to NavigateData
38334>>>        Get HasRecord of hoDD to bHasRecord
38335>>>
38335>>>        // let's hide all buttons and then Show the ones we want
38335>>>        WebSet pbRender of oEditBtn to False
38336>>>        WebSet pbRender of oSaveBtn to False
38337>>>        WebSet pbRender of oCancelChangesBtn to False
38338>>>        WebSet pbRender of oDeleteBtn to False
38339>>>
38339>>>        If (NavigateData.bReadOnly) Begin
38341>>>            WebSet pbRender of oEditBtn to True
38342>>>        End
38342>>>>
38342>>>        Else Begin
38343>>>            WebSet pbRender of oSaveBtn to True
38344>>>            WebSet pbRender of oCancelChangesBtn to True
38345>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38346>>>        End
38346>>>>
38346>>>    End_Procedure
