38961>>>    Procedure SetActionButtons
38964>>>        tWebNavigateData NavigateData
38964>>>        tWebNavigateData NavigateData
38964>>>        Boolean bHasRecord
38964>>>        Handle hoDD
38964>>>
38964>>>        Get Server to hoDD
38965>>>        Get GetNavigateData to NavigateData
38966>>>        Get HasRecord of hoDD to bHasRecord
38967>>>
38967>>>        // let's hide all buttons and then Show the ones we want
38967>>>        WebSet pbRender of oEditBtn to False
38968>>>        WebSet pbRender of oSaveBtn to False
38969>>>        WebSet pbRender of oCancelChangesBtn to False
38970>>>        WebSet pbRender of oDeleteBtn to False
38971>>>
38971>>>        If (NavigateData.bReadOnly) Begin
38973>>>            WebSet pbRender of oEditBtn to True
38974>>>        End
38974>>>>
38974>>>        Else Begin
38975>>>            WebSet pbRender of oSaveBtn to True
38976>>>            WebSet pbRender of oCancelChangesBtn to True
38977>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38978>>>        End
38978>>>>
38978>>>    End_Procedure
