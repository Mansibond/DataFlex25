39002>>>                // If from child, this is a probably a parent Zoom from a Zoom.
39002>>>                Case Break
39003>>>
39003>>>            Case Else // must be nfUndefined
39003>>>
39003>>>        Case End
39003>>>
39003>>>        Send SetActionButtons
