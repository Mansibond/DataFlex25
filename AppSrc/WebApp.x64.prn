37634>>>
37634>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37637>>>        Case Begin
37637>>>            Case (NavigateData.eNavigateType = nfFromMain)
37639>>>                // If from main, this is a propbably a main file Select to Zoom.
37639>>>                Case Break
37640>>>
37640>>>            Case (NavigateData.eNavigateType = nfFromParent)
37643>>>                // If from parent, this is a constrained drill down.
37643>>>                Case Break
37644>>>
37644>>>            Case (NavigateData.eNavigateType = nfFromChild)
37647>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37647>>>                Case Break
37648>>>
37648>>>            Case Else // must be nfUndefined
37648>>>
37648>>>        Case End
37648>>>
37648>>>        Send SetActionButtons
37649>>>
37649>>>    End_Procedure
37650>>>
37650>>>End_Object 
