37633>>>
37633>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37636>>>        Case Begin
37636>>>            Case (NavigateData.eNavigateType = nfFromMain)
37638>>>                // If from main, this is a propbably a main file Select to Zoom.
37638>>>                Case Break
37639>>>
37639>>>            Case (NavigateData.eNavigateType = nfFromParent)
37642>>>                // If from parent, this is a constrained drill down.
37642>>>                Case Break
37643>>>
37643>>>            Case (NavigateData.eNavigateType = nfFromChild)
37646>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37646>>>                Case Break
37647>>>
37647>>>            Case Else // must be nfUndefined
37647>>>
37647>>>        Case End
37647>>>
37647>>>        Send SetActionButtons
37648>>>
37648>>>    End_Procedure
37649>>>
