37605>>>    Procedure SetActionButtons
37608>>>        tWebNavigateData NavigateData
37608>>>        tWebNavigateData NavigateData
37608>>>        Boolean bHasRecord
37608>>>        Handle hoDD
37608>>>
37608>>>        Get Server to hoDD
37609>>>        Get GetNavigateData to NavigateData
37610>>>        Get HasRecord of hoDD to bHasRecord
37611>>>
37611>>>        // let's hide all buttons and then Show the ones we want
37611>>>        WebSet pbRender of oEditBtn to False
37612>>>        WebSet pbRender of oSaveBtn to False
37613>>>        WebSet pbRender of oCancelChangesBtn to False
37614>>>        WebSet pbRender of oDeleteBtn to False
37615>>>
37615>>>        If (NavigateData.bReadOnly) Begin
37617>>>            WebSet pbRender of oEditBtn to True
37618>>>        End
37618>>>>
37618>>>        Else Begin
37619>>>            WebSet pbRender of oSaveBtn to True
37620>>>            WebSet pbRender of oCancelChangesBtn to True
37621>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37622>>>        End
37622>>>>
37622>>>    End_Procedure
